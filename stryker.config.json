{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/stryker.json"
  },
  "coverageAnalysis": "perTest",
  "timeoutMS": 20000,
  "concurrency": 4,
  "mutate": [
    "src/lib/problemasWaTemplates.ts",
    "src/lib/clickDedup.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 50,
    "break": 40
  }
}