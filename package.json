{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-sitemaps.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemaps.mjs && bun scripts/check-seo-basics.ts index.html && node scripts/check-security-findings-baseline.mjs",
    "build": "vite build",
    "postbuild": "bun scripts/check-seo-basics.ts dist/index.html && bun scripts/check-seo-basics.ts --curated dist && node scripts/check-jsonld-references.mjs dist",
    "build:dev": "node scripts/generate-sitemaps.mjs && vite build --mode development",
    "check:seo": "bun scripts/check-seo-basics.ts index.html",
    "check:seo:curated": "bun scripts/check-seo-basics.ts --curated dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test e2e/smoke-buttons.spec.ts",
    "validate:jsonld": "node scripts/validate-jsonld-static.mjs",
    "validate:jsonld:runtime": "node scripts/validate-jsonld.mjs",
    "test:validate-jsonld": "node scripts/validate-jsonld-static.test.mjs",
    "lh:desktop": "lhci autorun --config=lighthouserc.json",
    "lh:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "lh:all": "npm run build && npm run lh:desktop && npm run lh:mobile && npm run perf:budgets",
    "perf:budgets": "node scripts/check-performance-budgets.mjs",
    "ci:seo": "npm run build && npm run validate:jsonld && npm run test:e2e",
    "indexnow:ping": "node scripts/indexnow-ping.mjs",
    "check:cta-funnel": "bun scripts/check-cta-funnel.ts",
    "check:editorial-governance": "node scripts/check-editorial-governance.mjs",
    "check:editorial-pilot": "node scripts/check-editorial-pilot.mjs",
    "check:editorial-technical-review": "node scripts/check-editorial-technical-review.mjs",
    "check:bairro-copy": "node scripts/validate-bairro-copy.mjs",
    "check:jsonld-refs": "node scripts/check-jsonld-references.mjs",
    "check:internal-links": "node scripts/check-internal-links.mjs",
    "check:internal-links:strict": "node scripts/check-internal-links.mjs --strict",
    "check:aggregate-rating": "node scripts/check-aggregate-rating.mjs",
    "check:recurring-language": "node scripts/check-recurring-language.mjs",
    "check:public-data-exposure": "node scripts/check-public-data-exposure.mjs",
    "check:security-findings": "node scripts/check-security-findings-baseline.mjs",
    "check:security-headers": "node scripts/check-security-headers.mjs",
    "check:security-headers:file": "bun scripts/check-security-headers.ts",
    "check:security": "npm run check:public-data-exposure && npm run check:security-findings",
    "preview:category-prompts": "bun scripts/preview-category-prompts.ts",
    "e2e:matrix:shard": "playwright test --config=playwright.ci.config.ts",
    "e2e:matrix:merge": "playwright merge-reports --reporter json ./all-blob-reports > merged-report/results.json",
    "e2e:matrix:report": "node scripts/consolidate-e2e-failures.mjs merged-report/results.json --out docs/e2e-inventario-falhas.md"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@playwright/test": "^1.57.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.90.1",
    "@tanstack/react-query": "^5.83.0",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.61.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "web-vitals": "^5.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vite-imagetools": "^10.0.1",
    "vitest": "^4.1.9"
  }
}
