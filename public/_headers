# CDN cache headers (honored by Cloudflare Pages / Netlify-compatible hosts).
# Vite emits content-hashed filenames under /assets/*, so they are safe to
# cache forever — `immutable` lets browsers and the CDN skip revalidation.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Garantia extra para extensões hasheadas (JS/CSS/fontes/imagens) servidas
# fora de /assets/* — também imutáveis quando contêm hash de conteúdo.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# HTML: revalidação rápida — deploys propagam em segundos.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Hashed responsive OG/hero images live under /assets/ already, but the
# canonical (non-hashed) OG fallbacks live at the project root, e.g.
# /og/arrumar-pc-<slug>.jpg — cache them aggressively but allow refresh.

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Per-city prerendered HTML — short edge cache so deploys propagate quickly,
# longer SWR window to keep crawlers fast.
/arrumar-pc/*
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

# Favicon / manifest
/favicon.png
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/manifest.json
  Cache-Control: public, max-age=86400
