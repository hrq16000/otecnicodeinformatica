# RODADA 1 — CONFIGURAÇÃO DE IDENTIDADE DO REMIX
# Copie para `.env` e preencha com os dados REAIS da nova operação.
# Regra de ouro: nada aqui pode receber valor da marca de origem.
# Variáveis vazias = recurso desligado (fail-closed), nunca fallback herdado.

# --- Marca ---
VITE_BRAND_NAME="O Técnico de Informática"
VITE_BRAND_SHORT_NAME="O Técnico de Informática"
VITE_BRAND_LEGAL_NAME=""
# Ano de fundação REAL da nova operação. Vazio = nenhuma claim de tempo de mercado é exibida.
VITE_BRAND_FOUNDED_YEAR=""

# --- Domínio e indexação ---
# Sem domínio, canonical/og:url/sitemap ficam desativados.
VITE_SITE_DOMAIN=""
# Só coloque "true" quando o conteúdo próprio estiver pronto e o domínio ativo.
VITE_SITE_INDEXING_ENABLED="false"

# --- Contato (funil) ---
# Somente dígitos, formato E.164 sem "+": ex. 5511999999999
# Vazio = todos os CTAs caem na rota /funil-indisponivel (nenhum lead vaza).
VITE_WHATSAPP_NUMBER=""

# --- Localização comercial ---
VITE_PRIMARY_CITY=""
VITE_REGION=""
VITE_SERVICE_AREA=""

# --- Analytics / monetização (opcionais) ---
# Vazio = scripts nem são carregados. Nunca reutilizar propriedades de terceiros.
VITE_GA4_ID=""
VITE_GOOGLE_ADS_ID=""
VITE_GOOGLE_ADS_CONVERSION_LABEL=""
VITE_ADSENSE_CLIENT=""
